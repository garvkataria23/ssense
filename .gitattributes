# Force binary (no line-ending mangling) for image/media files
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.svg binary
*.mp4 binary

# Text files: normalize to LF in repo, CRLF on Windows checkout
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.php text eol=lf
*.txt text eol=lf
*.xml text eol=lf
.htaccess text eol=lf